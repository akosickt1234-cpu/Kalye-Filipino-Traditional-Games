{
  "name": "kftg-backend",
  "version": "0.1.0",
  "private": true,
  "description": "backend for kalye filipino traditional games",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/infrastructure/database/migration_runner.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@colyseus/core": "0.16.26",
    "@colyseus/monitor": "0.16.7",
    "@colyseus/schema": "3.0.76",
    "@colyseus/ws-transport": "0.16.5",
    "argon2": "^0.44.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "colyseus.js": "0.16.22",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3"
  }
}
